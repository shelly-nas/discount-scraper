# Database Configuration (used by Docker Compose and Node.js application)
DB_NAME=discount
DB_USER=discount_user
DB_PASSWORD=change_this_password

# Logging Configuration
LOG_LEVEL=INFO

# CORS: comma separated list of allowed web origins (e.g. the Baskit web app).
# Leave empty to allow every origin (development).
CORS_ORIGINS=

# Full product catalog scrape (regular prices). Weekly by default.
# CATALOG_CRON uses cron syntax in the container's time zone.
CATALOG_ENABLED=true
CATALOG_CRON=17 3 * * 1
